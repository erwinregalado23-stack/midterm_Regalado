@model List<midterm_Regalado.Models.CartItem>

<h2 class="mb-4">🛒 Your Cart</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th style="width:180px">Quantity</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>₱@item.Price.ToString("N2")</td>
                <td>
                    <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" />
                        <button class="btn btn-sm btn-warning">Update</button>
                    </form>
                </td>
                <td>₱@((item.Price * item.Quantity).ToString("N2"))</td>
                <td>
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-sm btn-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Grand Total:</th>
                <th colspan="2" class="text-primary fs-5">
                    ₱@Model.Sum(i => i.Price * i.Quantity).ToString("N2")
                </th>
            </tr>
        </tfoot>
    </table>
}